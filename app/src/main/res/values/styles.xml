<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.BeanLoyal.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="TextAppearance.BeanLoyal.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="TextAppearance.BeanLoyal.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>
    <style name="TextAppearance.BeanLoyal.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>
    <style name="TextAppearance.BeanLoyal.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="Widget.BeanLoyal.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/colorPrimaryContainer</item>
    </style>
    <style name="Widget.BeanLoyal.Card.Brand" parent="Widget.BeanLoyal.Card">
        <item name="cardBackgroundColor">@color/colorPrimary</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
    </style>
    <style name="Widget.BeanLoyal.Card.Soft" parent="Widget.BeanLoyal.Card">
        <item name="cardBackgroundColor">@color/colorSurfaceVariant</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.BeanLoyal.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.BeanLoyal.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="Widget.BeanLoyal.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.BeanLoyal.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/colorSurface</item>
        <item name="boxStrokeColor">@color/colorOutline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/colorOnSurfaceVariant</item>
        <item name="startIconTint">@color/colorOnSurfaceVariant</item>
        <item name="endIconTint">@color/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.BeanLoyal.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">40dp</item>
        <item name="chipBackgroundColor">@color/chip_background_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.BeanLoyal.Label</item>
    </style>
    <style name="Widget.BeanLoyal.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/colorOnSurface</item>
        <item name="subtitleTextColor">@color/colorOnSurfaceVariant</item>
        <item name="navigationIconTint">@color/colorOnSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.BeanLoyal.Title</item>
    </style>
</resources>
