# Copy to keystore.properties (git-ignored) and fill in real values.
# storeFile is resolved relative to the repo root; an absolute path also works.
# Keep the .jks file and these passwords out of the repository — losing them
# means the app can never be updated on Play under the same key.
storeFile=beanloyal-admin-release.jks
storePassword=
keyAlias=beanloyal-admin
keyPassword=
